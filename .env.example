# =============================================================================
# WMS Backend — environment template
# Copy to `.env` (or set the same keys in Render / your host). Do not commit real secrets.
# =============================================================================
#
# Your production reference:
#   API (this service):  https://ewms-k9l2.onrender.com
#   Web app (frontend):  https://psychotic.expo.app
#
# ----------------------------------------------------------------------------- 
# Core
# ----------------------------------------------------------------------------- 
# development | production | test  (loads `.env.<APP_ENV>` overrides when not production)
APP_ENV=development

# Render sets PORT automatically. Local default is 4000.
# PORT=4000

# MongoDB connection string (required)
MONGO_URI=mongodb://127.0.0.1:27017/wms
# Optional split by environment (server.js merges when APP_ENV=production):
# MONGO_URI_DEV=mongodb://127.0.0.1:27017/wms_dev
# MONGO_URI_PROD=mongodb+srv://USER:PASS@cluster.mongodb.net/wms

# JWT for access tokens (required)
JWT_SECRET=change_me_to_a_long_random_string
# Optional split:
# JWT_SECRET_DEV=dev_jwt_secret
# JWT_SECRET_PROD=prod_jwt_secret_min_32_chars

# Refresh tokens (required — auth.js fails fast if missing)
REFRESH_TOKEN_SECRET=change_me_to_a_different_long_random_string

# Access / refresh lifetimes (optional)
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=30d

# ----------------------------------------------------------------------------- 
# CORS — browser origins allowed to call this API
# ----------------------------------------------------------------------------- 
# Comma-separated list, no spaces (or trim-safe — check server.js parsing).
# Production must include your hosted web app:
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# CORS_ORIGINS_PROD=https://psychotic.expo.app
# CORS_ORIGINS_DEV=http://localhost:8081,http://localhost:19006

# ----------------------------------------------------------------------------- 
# Public URLs (emails, verification links)
# ----------------------------------------------------------------------------- 
# Used in verification / invite links (must match your deployed Expo web URL in production)
FRONTEND_URL=http://localhost:19006
# Production:
# FRONTEND_URL=https://psychotic.expo.app

# ----------------------------------------------------------------------------- 
# Email (Nodemailer) — required for signup + resend verification
# ----------------------------------------------------------------------------- 
# Examples: Gmail smtp.gmail.com + App Password; SendGrid; Outlook smtp.office365.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# EMAIL_FROM=noreply@yourdomain.com
# Only if SMTP uses a self-signed cert (rare)
# EMAIL_TLS_INSECURE=false

# Shown in email copy and privacy policy
# APP_NAME=WMS
# SUPPORT_EMAIL=support@yourdomain.com

# Verification token/code lifetime in hours (default 0.25 = 15 minutes)
# VERIFICATION_EXPIRY_HOURS=0.25

# ----------------------------------------------------------------------------- 
# Signup / admin bootstrap
# ----------------------------------------------------------------------------- 
# If set, signup requests with matching adminCode become role=admin.
# In production, leave unset after your first admin exists (see backend auth routes).
# ADMIN_SIGNUP_CODE=

# ----------------------------------------------------------------------------- 
# Optional: Sentry, Redis, Web Push, logging, business defaults
# ----------------------------------------------------------------------------- 
# SENTRY_DSN=https://...@.ingest.sentry.io/...

# Bull / job queue (if used)
# REDIS_URL=

# Web Push (server) — pair with frontend EXPO_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:admin@yourdomain.com

# LOG_LEVEL=debug

# Low-stock notifications (default 5 if unset or invalid)
# LOW_STOCK_THRESHOLD=5

# ----------------------------------------------------------------------------- 
# Seed script only (backend/scripts/seed.js) — not for normal server startup
# ----------------------------------------------------------------------------- 
# RUN_SEED=true
# ALLOW_PRODUCTION_SEED=true
# SEED_COMPANY=Demo Corp
# SEED_SITE=main
# SEED_PASSWORD=DemoSeed#1A
# SEED_ADMIN_EMAIL=admin@demo.local
# SEED_USER_EMAIL=user@demo.local
