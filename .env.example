# Nodemailer / SMTP — required for signup and resend verification emails
# Examples: Gmail smtp.gmail.com + App Password; SendGrid smtp.sendgrid.net; Outlook smtp.office365.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Optional: From header (defaults to EMAIL_USER)
# EMAIL_FROM=noreply@yourdomain.com
# Only if your SMTP uses a self-signed cert (not typical for public providers)
# EMAIL_TLS_INSECURE=false

# Used in verification email links (Expo web / hosted app URL)
# FRONTEND_URL=http://localhost:19006

# APP_NAME=WMS
# VERIFICATION_EXPIRY_HOURS=0.25
